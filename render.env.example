# Paste these variables into the Render service environment.
# Replace every REPLACE_ME value with the matching value from your local .env.
# Do not commit or paste your local .env file itself.

PYTHON_VERSION=3.12.0
VITE_API_BASE_URL=/api
LOCAL_INGESTION_WORKER=true
LOCAL_INGESTION_POLL_SECONDS=3

# Same-origin deployment: the React frontend and FastAPI backend are served
# by the same Render service. Replace this host if your Render URL differs.
CORS_ORIGINS=https://your-service.onrender.com
GITHUB_FRONTEND_ORIGIN=https://your-service.onrender.com
GITHUB_REDIRECT_URI=https://your-service.onrender.com/api/github/callback

# Required server credentials
NVIDIA_API_KEY=REPLACE_ME
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
SUPABASE_URL=REPLACE_ME
SUPABASE_KEY=REPLACE_ME
TURSO_DATABASE_URL=REPLACE_ME
TURSO_AUTH_TOKEN=REPLACE_ME

# GitHub OAuth and reviewed PR workflow
GITHUB_CLIENT_ID=REPLACE_ME
GITHUB_CLIENT_SECRET=REPLACE_ME
GITHUB_TOKEN_ENCRYPTION_KEY=REPLACE_ME
EDITING_TICKET_SECRET=REPLACE_ME
EDITING_TICKET_TTL_SECONDS=600
GITHUB_OAUTH_STATE_TTL_SECONDS=600
MAX_GITHUB_CHANGE_BYTES=10000000
GITHUB_EDITOR_MAX_BYTES=2000000

# Razorpay billing. The public key may be exposed to the frontend; the secret
# must remain server-only.
RAZORPAY_KEY_ID=REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
VITE_RAZORPAY_KEY_ID=REPLACE_ME
TEAM_PLAN_AMOUNT_PAISE=30000
TEAM_PLAN_DURATION_DAYS=30

# Confirmed NVIDIA models. Do not use the retired Qwen IDs from older .env files.
NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b
DETAILED_NEMOTRON_MODEL=nvidia/nemotron-3-ultra-550b-a55b
CODE_EDITING_MODEL=nvidia/nemotron-3-super-120b-a12b
CODE_EDITING_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
EMBEDDING_DIMENSION=2048
NVIDIA_CALLS_PER_MINUTE=20

# Bounded ingestion for the 512 MB Render instance
MAX_REPOSITORY_FILES=5000
MAX_REPOSITORY_BYTES=100000000
MAX_FILE_SIZE_BYTES=50000000
MAX_REPOSITORY_CHUNKS=3500
CHUNK_INSERT_BATCH_SIZE=250
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MIN_BATCH_SIZE=4
EMBEDDING_CHUNK_BUFFER_SIZE=64
EMBEDDING_RETRY_ATTEMPTS=5
EMBEDDING_RETRY_BASE_SECONDS=2
EMBEDDING_PROGRESS_INTERVAL_BATCHES=4
EMBEDDING_HEARTBEAT_INTERVAL_BATCHES=2
INGESTION_JOB_TIMEOUT_SECONDS=900
MAX_INGESTION_ATTEMPTS=3
CLONE_TIMEOUT_SECONDS=180

# Per-user quotas: 200 MB free, 800 MB with the Team plan
FREE_CODEBASE_BYTES=200000000
TEAM_CODEBASE_BYTES=800000000
MAX_REPOSITORIES_PER_USER=30
MAX_ACTIVE_INGESTION_JOBS_PER_USER=1

# Interactive retrieval and request safety
MAX_CONTEXT_CHARACTERS=40000
RETRIEVAL_TOP_K=8
EDITING_RETRIEVAL_TOP_K=32
DENSE_CANDIDATE_LIMIT=256
OVERVIEW_RETRIEVAL_CANDIDATES=64
ANSWER_RETRY_ATTEMPTS=2
INGEST_REQUESTS_PER_MINUTE=6
QUERY_REQUESTS_PER_MINUTE=12
MAX_CONCURRENT_QUERIES_PER_USER=2
CONVERSATION_HISTORY_MESSAGES=6
MAX_CONVERSATION_HISTORY_CHARACTERS=7200
MAX_CONVERSATION_MESSAGE_CHARACTERS=1800

# Frontend Supabase configuration. This is the public anonymous key, never a
# Supabase service-role key.
VITE_SUPABASE_URL=REPLACE_ME
VITE_SUPABASE_ANON_KEY=REPLACE_ME
