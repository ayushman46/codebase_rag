# Backend: NVIDIA Nemotron (never commit a real key)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Backend: Supabase service role is preferred for server-side writes.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend configuration (the frontend reads these from the project root).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional backend controls
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
