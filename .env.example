# Backend: NVIDIA Nemotron (never commit a real key)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b
DETAILED_NEMOTRON_MODEL=nvidia/nemotron-3-ultra-550b-a55b
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
EMBEDDING_DIMENSION=2048
# Conservative defaults for NVIDIA's shared hosted endpoint. Increasing these
# can shorten indexing but may cause HTTP 503/429 responses for large repos.
EMBEDDING_BATCH_SIZE=4
NVIDIA_CALLS_PER_MINUTE=20
EMBEDDING_RETRY_ATTEMPTS=5
EMBEDDING_RETRY_BASE_SECONDS=2

# Backend: Supabase is used only to validate Google-authenticated sessions.
SUPABASE_URL=
SUPABASE_KEY=

# Backend: Turso owns repositories, ingestion jobs, chunks, vectors, and chat.
# These values are server secrets. Never prefix them with VITE_.
TURSO_DATABASE_URL=libsql://YOUR_DATABASE-YOUR_ORGANIZATION.turso.io
TURSO_AUTH_TOKEN=

# Frontend configuration (the frontend reads these from the project root).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Local development: http://localhost:8000/api
# Render production: /api
VITE_API_BASE_URL=http://localhost:8000/api

# Optional backend controls
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

INGESTION_JOB_TIMEOUT_SECONDS=900
MAX_INGESTION_ATTEMPTS=3
# Set to false only when another process is responsible for calling the queue worker.
LOCAL_INGESTION_WORKER=true
LOCAL_INGESTION_POLL_SECONDS=3
MAX_REPOSITORY_FILES=5000
MAX_REPOSITORY_BYTES=25000000
MAX_FILE_SIZE_BYTES=5000000
MAX_REPOSITORY_CHUNKS=1500
MAX_REPOSITORIES_PER_USER=30
MAX_ACTIVE_INGESTION_JOBS_PER_USER=1
INGEST_REQUESTS_PER_MINUTE=6
QUERY_REQUESTS_PER_MINUTE=12
MAX_CONCURRENT_QUERIES_PER_USER=2
CLONE_TIMEOUT_SECONDS=180
MAX_CONTEXT_CHARACTERS=40000
RETRIEVAL_TOP_K=8
OVERVIEW_RETRIEVAL_CANDIDATES=64
