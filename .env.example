# Backend: NVIDIA Nemotron (never commit a real key)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3-ultra-550b-a55b
EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5

# Backend: Supabase service role is preferred for server-side writes.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend configuration (the frontend reads these from the project root).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Local development: http://localhost:8000/api
# Render production: /api
VITE_API_BASE_URL=http://localhost:8000/api

# Optional backend controls
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

INGESTION_JOB_TIMEOUT_SECONDS=900
MAX_INGESTION_ATTEMPTS=3
# Set to false only when another process is responsible for calling the queue worker.
LOCAL_INGESTION_WORKER=true
LOCAL_INGESTION_POLL_SECONDS=3
MAX_REPOSITORY_FILES=5000
MAX_REPOSITORY_BYTES=25000000
MAX_REPOSITORY_CHUNKS=1500
